#pragma once
#include "MetalShapeSideLight.metalh"
#include "MetalShapeContour.metalh"
#include "MetalShapeDirectionalBlur.metalh"
#include "MetalShapeRadial.metalh"
#include "MetalShapeProceduralLight.metalh"
#include "MetalShapeProceduralFlow.metalh"
#include "MetalShapeProceduralContour.metalh"
#include "MetalShapeEclipseGlow.metalh"
#include "MetalShapeSunset.metalh"

static void metalShapeShadeConcentricRings(
    float2 p,
    float body,
    constant MetalShapeMaterialUniforms &m,
    thread float3 &color,
    thread float &alpha) {
    const float radius = length(p);
    const float ringCount = mix(7.0, 15.0, m.params0.y);
    const float phase = fract(radius * ringCount);
    const float inwardFade = smoothstep(0.16, 0.78, phase);
    const float crispOuterEdge = 1.0 - smoothstep(0.965, 1.0, phase);
    const float transparentCenter = smoothstep(0.012, 0.035, radius);
    const float ring = inwardFade * crispOuterEdge * transparentCenter;
    const float ringIndex = floor(radius * ringCount);
    // Each line grows quieter toward the centre: inner rings lose opacity and
    // saturation while the outer edge keeps a clear, water-ripple accent.
    const float ringProgress = saturate(ringIndex / max(ceil(ringCount) - 1.0, 1.0));
    const float opacity = mix(0.055, 0.64, pow(ringProgress, 1.12));
    const float gradient = smoothstep(0.28, 0.98, phase);

    color = mix(m.color1.rgb, m.color0.rgb, gradient);
    const float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    color = mix(float3(luminance), color, mix(0.24, 1.0, ringProgress));
    alpha = body * ring * opacity;
}

static void metalShapeShadeSpiralVariation(
    float2 p,
    constant MetalShapeMaterialUniforms &m,
    thread float3 &color,
    thread float &alpha) {
    const float radius = length(p);
    const float absAngle = clamp(abs(m.params0.y), 5.0, 80.0) * M_PI_F / 180.0;
    const float pitch = copysign(0.20, m.params0.y) * (1.0 / tan(absAngle));
    const float theta = atan2(p.y, p.x);
    const float phase = theta - pitch * log(max(radius, 0.001) / 0.16) + m.params0.x * 2.0 * M_PI_F;
    const float spacing = 2.0 * M_PI_F / max(m.params1.z, 1.0);
    const float wrapped = phase - round(phase / spacing) * spacing;
    const float distance = radius * abs(wrapped) / sqrt(1.0 + pitch * pitch);
    const float aa = max(fwidth(distance), 0.0008);
    const float line = 1.0 - smoothstep(m.params0.z, m.params0.z + aa * 1.4, distance);
    const float inner = smoothstep(0.145, 0.17, radius);
    const float outer = 1.0 - smoothstep(0.91, 0.96, radius);
    color = m.color0.rgb;
    alpha = line * inner * outer * m.params0.w;
}

static float4 metalShapeGenomeShade(
    MetalShapeVertexOut in,
    constant MetalShapeGenomeUniforms &g,
    constant MetalShapeMaterialUniforms &m) {
    const float2 p = (in.uv - 0.5) * 2.72;
    const float distance = metalShapeDistance(p, g);
    const float antialias = max(fwidth(distance), 0.0025);
    const float body = smoothstep(antialias, -antialias, distance);
    const float2 direction = normalize(m.params1.xy);
    const float materialPhase = m.params0.x * 2.0 * M_PI_F;
    const uint material = min(m.metadata.x, 12u);
    float3 color = m.color0.rgb;
    float alpha = body;

    if (material == 1u) {
        metalShapeShadeSideLight(p, direction, materialPhase, m, color);
    } else if (material == 2u) {
        metalShapeShadeContour(distance, m, color, alpha);
    } else if (material == 3u) {
        metalShapeShadeDirectionalBlur(p, direction, antialias, g, m, color, alpha);
    } else if (material == 4u || material == 5u) {
        metalShapeShadeRadial(p, material, g, m, color);
    } else if (material == 6u) {
        metalShapeShadeProceduralLight(p, m, color);
    } else if (material == 7u) {
        metalShapeShadeProceduralFlow(p, direction, materialPhase, body, m, color, alpha);
    } else if (material == 8u) {
        metalShapeShadeProceduralContour(distance, materialPhase, body, m, color, alpha);
    } else if (material == 9u) {
        metalShapeShadeEclipseGlow(p, distance, m, color, alpha);
    } else if (material == 12u) {
        metalShapeShadeSpiralVariation(p, m, color, alpha);
    }

    if (material == 10u) {
        metalShapeShadeSunset(p, m, color, alpha);
    } else if (material == 11u) {
        metalShapeShadeConcentricRings(p, body, m, color, alpha);
    }
    return float4(color * alpha, alpha);
}
